# call-insights reads ../caller-qa-py/.env by default (same Azure, Postgres and Vertex settings as Qualivio).
# Put a .env next to this file only to override individual values. Set CI_SHARED_ENV to point elsewhere.

# CI_SHARED_ENV=../caller-qa-py/.env

# Postgres - same database and schema as Qualivio; call-insights only creates/uses tables prefixed ci_
# DATABASE_URL=
# DB_SCHEMA=qualivio-qa

# Azure Blob (audio is stored under the CI_BLOB_PREFIX folder of the Qualivio recording container)
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_RECORDING_CONTAINER_NAME=
# CI_BLOB_PREFIX=call-insights

# Azure Speech batch transcription
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_BATCH_ENDPOINT=

# Vertex AI (Gemini)
# GCP_PROJECT_ID=
# GCP_LOCATION=global
# GCP_CLIENT_EMAIL=
# GCP_PRIVATE_KEY=
# GEMINI_MODEL_VERSION=gemini-3.8-flash
# GEMINI_MODEL_EXTRACT=           (defaults to GEMINI_MODEL_VERSION)
# GEMINI_THINKING_EXTRACT=HIGH
